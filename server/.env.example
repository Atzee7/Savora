NODE_ENV=development
PORT=4000

# --- Database lokal ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savora?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/savora?schema=public"

# --- Supabase (ganti blok lokal di atas saat deploy) ---
# Dashboard Supabase -> Connect -> Connection string.
# DATABASE_URL  : transaction pooler, port 6543 (dipakai Prisma Client)
# DIRECT_URL    : session pooler, port 5432 (dipakai prisma migrate/introspect)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Origin frontend yang diizinkan CORS.
# Lokal: http://localhost:5173 — produksi: https://<project>.vercel.app
CLIENT_URL="http://localhost:5173"
